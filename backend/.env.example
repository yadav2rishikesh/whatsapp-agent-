# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional — defaults shown
# DATABASE_URL=sqlite:///./portfolio.db          # use a Postgres URL in production
# MODEL_FAST=openai/gpt-4.1-mini
# MODEL_STRONG=openai/gpt-4.1
# MODEL_FALLBACK=google/gemini-2.5-flash
# LLM_TIMEOUT_S=30
# OPENROUTER_PROVIDER_SORT=latency               # route to the lowest-latency provider
# MAX_OUTPUT_TOKENS=1200                         # caps reply length (also keeps credit reservations low)
# MAX_AGENT_STEPS=6
# CORS_ORIGINS=*                                  # set to your frontend URL in production
# ADMIN_TOKEN=                                    # set to protect the business console
